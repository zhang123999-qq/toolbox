{
  "name": "toolbox",
  "version": "0.0.8",
  "private": true,
  "license": "MIT",
  "description": "870 client-side online tools: local-first, static deployment, bilingual",
  "homepage": "https://006336.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang123999-qq/toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/zhang123999-qq/toolbox/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build --concurrency=1",
    "build:ssg": "sh scripts/build-ssg.sh",
    "build:ssg:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ssg.ps1",
    "build:ssg:inline": "pnpm generate:sitemap && pnpm generate:search-index && pnpm --filter @toolbox/web build && pnpm --filter @toolbox/web build:ssr && pnpm prerender",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "generate:catalog:check": "tsx scripts/generate-catalog.ts --check",
    "check:bundle-size": "tsx scripts/check-bundle-size.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:search-index": "tsx scripts/build-search-index.ts",
    "check:tools": "tsx scripts/check-tools.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:licenses:strict": "tsx scripts/check-licenses.ts --strict",
    "check:source-org": "tsx scripts/check-source-org.ts",
    "prerender": "tsx scripts/prerender.ts",
    "verify": "pnpm check:tools && pnpm check:source-org && pnpm check:env && pnpm check:docs && pnpm check:licenses && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "check:env": "tsx scripts/check-env-config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@toolbox/catalog": "workspace:*",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "turbo": "^2.11.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "overrides": {
      "image-size": "^2.0.3",
      "source-map-js": "^1.2.2",
      "dompurify": "^3.4.17"
    }
  }
}
