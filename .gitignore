node_modules/
dist/
dist-ssr/
.turbo/
coverage/
*.local
.DS_Store
.env
.env.*
!.env.example
*.log
logs/

# 密钥与证书（TLS 证书、私钥、打包签名等，一旦误提即为泄露）
*.pem
*.key
*.p12
*.pfx
id_rsa*
*.keystore

# 编辑器与系统文件
.idea/
*.swp
*.swo
Thumbs.db

# TypeScript 增量构建缓存
*.tsbuildinfo

# pnpm 本地 store（依赖缓存，体积大且可重建）
.pnpm-store/

# 测试产物
playwright-report/
test-results/
blob-report/

# 开发日志与智能体工作状态（非源码，不入库）
.agent/logs/
.workbuddy/

# 构建期生成（由 pnpm generate:sitemap 产出）
apps/web/public/sitemap.xml
apps/web/public/robots.txt

# 本地临时验证产物（浏览器验证脚本与其截图，不入库）
tmp-shots/
apps/web/verify.mjs

# 二进制部署产物（由 deploy/binary/build-bundle.sh 生成）
dist-release/

# 铺量期的临时生成脚本（一次性，用完即删）
tmp/
